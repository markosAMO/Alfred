{
  "name": "ventas",
  "title": "Sales follow-up",
  "description": "Prospect, propose, follow up and close",
  "rules": "rules.md",
  "phases": [
    {"name": "prospectar", "model": "anthropic/claude-haiku-4-5"},
    {"name": "propuesta", "model": "anthropic/claude-opus-5", "tools": ["Read", "Write", "WebFetch"]},
    {"name": "seguimiento", "model": "anthropic/claude-haiku-4-5"},
    {"name": "review"}
  ],
  "routes": {
    "rapida": ["propuesta", "review"],
    "completa": ["prospectar", "propuesta", "seguimiento", "review"]
  },
  "default_route": "completa",
  "entry_points": {"default": "prospectar"},
  "parallel": [["propuesta", "seguimiento"]],
  "closes": "review"
}
