exit 1

--- stdout
workflows
  cobranzas   machine/custom   2 phases  routes: completa, sola
  inventario  machine/custom   3 phases  routes: corta, larga
  soporte     machine/shipped  2 phases  routes: completa, directa
  ventas      machine/shipped  4 phases  routes: completa, rapida

adopted      6 files and 6 agents written by an earlier version, recorded in the manifest
             for the first time. From here on they are refreshed and removed like anything
             else Alfred writes. This happens once.
             <work>/out/claude/agents/alfred-explore.md
             <work>/out/claude/agents/alfred-init.md
             <work>/out/claude/agents/alfred-manage.md
             <work>/out/claude/agents/alfred-spec.md
             <work>/out/claude/commands/alfred-worktree.md
             <work>/out/claude/commands/alfred.md
             alfred
             alfred-explore
             alfred-init
             alfred-manage
             alfred-spec
             alfred-worktree

claude code  (machine: <work>/out/claude)
  added      /alfred-add-workflow, /alfred-cobranzas, /alfred-explore, /alfred-init,
             /alfred-inventario, /alfred-soporte, /alfred-workflows-scanner, alfred-apply,
             alfred-archive, alfred-review, alfred-ventas-propuesta,
             alfred-ventas-prospectar, alfred-ventas-seguimiento
  updated    /alfred, /alfred-worktree, alfred-manage, alfred-spec
  removed    alfred-explore, alfred-init
  orphans    <work>/out/claude/agents/alfred-notes.md
             the generated naming, claimed by nothing; this run will not remove them
  collisions <work>/out/claude/commands/alfred-ventas.md
             not written: a file Alfred never generated already carries this name, so
             /alfred-ventas is missing on claude code; rename or remove it

opencode  (machine: <work>/out/opencode.json)
  added      alfred-add-workflow, alfred-apply, alfred-archive, alfred-cobranzas,
             alfred-inventario, alfred-review, alfred-soporte, alfred-ventas-propuesta,
             alfred-ventas-prospectar, alfred-ventas-seguimiento, alfred-workflows-scanner
  updated    alfred, alfred-explore, alfred-init, alfred-manage, alfred-spec,
             alfred-worktree
  collisions alfred-ventas
             not written: an agent Alfred never generated already carries this name, so
             alfred-ventas is missing on opencode; rename or remove it

without a model
  cobranzas/recordatorio  the workflow's own recordatorio declares no model and will not
                          be dispatched
